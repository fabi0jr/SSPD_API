# Copie para .env e troque os valores. Nunca commite o .env.

# Banco (api, worker, migrate)
DATABASE_URL=postgresql+psycopg://monitor:troque-esta-senha@postgres:5432/monitor

# Autenticação (api)
# JWT_SECRET: no mínimo 32 caracteres, senão a API não sobe. Gerar com: openssl rand -hex 32
JWT_SECRET=troque-por-uma-string-aleatoria-longa
JWT_EXP_MINUTES=60
SENSOR_API_KEY=troque-por-uma-string-aleatoria
CORS_ORIGINS=http://localhost:5173

# Seed
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=troque-esta-senha
SEED_PACIENTES=50

# Worker
WORKER_INTERVALO=2
WORKER_LOTE=500

# Simulador
API_URL=http://nginx/leituras
N_PACIENTES=10
INTERVALO=2

# Testes de integração (só local/CI). Banco DESCARTÁVEL: as tabelas são apagadas.
# Nunca aponte para o banco de produção. Ver backend/tests/integracao/conftest.py
# TEST_DATABASE_URL=postgresql+psycopg://monitor:teste@localhost:55432/monitor_teste
