# Copie para .env (na raiz, ao lado do docker-compose.yml) e troque os valores.
# Nunca commite o .env. Segredos: gerar com  openssl rand -hex 32

# Banco (postgres). O docker-compose.yml monta a DATABASE_URL da api, do worker
# e do migrate a partir destas três: a senha só com letras e números (o hex do
# openssl serve), porque vai na URL sem codificação.
POSTGRES_USER=monitor
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=monitor

# Fora do Compose (uvicorn local, ver README), a aplicação lê a URL completa:
# DATABASE_URL=postgresql+psycopg://monitor:senha@localhost:5432/monitor

# Autenticação (api)
# JWT_SECRET: no mínimo 32 caracteres, senão a API não sobe. Gerar com: openssl rand -hex 32
JWT_SECRET=troque-por-uma-string-aleatoria-longa
JWT_EXP_MINUTES=60
SENSOR_API_KEY=troque-por-uma-string-aleatoria
CORS_ORIGINS=http://localhost:5173

# Seed
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=troque-esta-senha
SEED_PACIENTES=50

# Worker
WORKER_INTERVALO=2
WORKER_LOTE=500

# Simulador (no Compose, o API_URL já é http://nginx/leituras)
N_PACIENTES=10
INTERVALO=2

# Nginx: porta publicada na VPS (80). Troque se a 80 estiver ocupada na sua máquina.
HTTP_PORT=80

# Testes de integração (só local/CI). Banco DESCARTÁVEL: as tabelas são apagadas.
# Nunca aponte para o banco de produção. Ver backend/tests/integracao/conftest.py
# TEST_DATABASE_URL=postgresql+psycopg://monitor:teste@localhost:55432/monitor_teste
