{
  "version": 1,
  "disable_existing_loggers": false,
  "formatters": {
    "padrao": {
      "format": "%(asctime)s %(levelname)s [%(name)s] %(message)s",
      "datefmt": "%Y-%m-%dT%H:%M:%S%z"
    },
    "acesso": {
      "()": "uvicorn.logging.AccessFormatter",
      "fmt": "%(asctime)s %(levelname)s [%(name)s] %(client_addr)s \"%(request_line)s\" %(status_code)s",
      "datefmt": "%Y-%m-%dT%H:%M:%S%z",
      "use_colors": false
    }
  },
  "handlers": {
    "padrao": {
      "class": "logging.StreamHandler",
      "formatter": "padrao",
      "stream": "ext://sys.stdout"
    },
    "acesso": {
      "class": "logging.StreamHandler",
      "formatter": "acesso",
      "stream": "ext://sys.stdout"
    }
  },
  "loggers": {
    "uvicorn": {"handlers": ["padrao"], "level": "INFO", "propagate": false},
    "uvicorn.error": {"level": "INFO"},
    "uvicorn.access": {"handlers": ["acesso"], "level": "INFO", "propagate": false}
  },
  "root": {"handlers": ["padrao"], "level": "INFO"}
}
